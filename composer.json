{
    "name": "timurturdyev/simple-settings",
    "description": "Key-value settings for Laravel: groups, caching, typed values, atomic batch writes and an optional audit log",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Timur Turdyev",
            "email": "borodatumur@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4|^8.5",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "TimurTurdyev\\SimpleSettings\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TimurTurdyev\\SimpleSettings\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TimurTurdyev\\SimpleSettings\\Providers\\SettingServiceProvider"
            ]
        }
    }
}
